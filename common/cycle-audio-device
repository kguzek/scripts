#!/usr/bin/env zsh
set -euo pipefail

PROGRAM_NAME="${0:t}"

print_help() {
  cat <<EOF
Usage: $PROGRAM_NAME OPTION

Options:
  --sink, -k
        cycle the active audio output device
  --source, -c
        cycle the active audio input device
  --help, -h
        display help message and exit
EOF
}

zparseopts -D -- \
  {k,-sink}=FLAG_SINK \
  {c,-source}=FLAG_SOURCE \
  {h,-help}=FLAG_HELP

if [[ -n "$FLAG_HELP" ]]; then
  print_help
  exit 0
fi

is_sink() {
  [[ -n "$FLAG_SINK" ]]
}

is_source() {
  [[ -n "$FLAG_SOURCE" ]]
}

if ! is_sink && ! is_source; then
  local error_description
  if (( $# > 0 )); then
    error_description="'$1': invalid"
  else
    error_description='missing'
  fi
  log-status failed "$PROGRAM_NAME: $error_description argument"
  print_help >&2
  exit 1
fi

if is_sink; then
  list_cmd=(pactl list sinks short)
  get_default=(pactl get-default-sink)
  set_default=(pactl set-default-sink)
  move_cmd=(pactl move-sink-input)
  mode='sink'
else
  list_cmd=(pactl list sources short)
  get_default=(pactl get-default-source)
  set_default=(pactl set-default-source)
  mode='source'
fi

typeset -a ids names

# build arrays
while read -r id name _; do
  if is_source && [[ "$name" == *.monitor || "$name" == alsa_input.pci-* ]]; then
    continue
  fi
  ids+=("$id")
  names+=("$name")
done < <("${list_cmd[@]}")

(( ${#ids[@]} == 0 )) && { echo "No devices"; exit 1; }

current="$("${get_default[@]}")"

current_index=-1

for (( i = 1; i <= ${#names[@]}; i++ )); do
  if [[ "${names[$i]}" == "$current" ]]; then
    current_index=$i
    break
  fi
done

# fallback if not found
if (( current_index == -1 )); then
  next_index=1
else
  next_index=$(( current_index % ${#names[@]} + 1 ))
fi

next_name="${names[$next_index]}"
next_id="${ids[$next_index]}"

"${set_default[@]}" "$next_name"

# move active streams (sink only; sources don’t need this usually)
if is_sink; then
  pactl list short sink-inputs | awk '{print $1}' | while read -r input; do
    pactl move-sink-input "$input" "$next_name"
  done
fi

echo "Switched default audio ${mode#--} -> $next_name (device $next_id)"
