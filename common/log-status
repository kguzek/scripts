#!/usr/bin/env zsh

set -e

PROGRAM_NAME="${0:t}"

set_colors() {
  local stream="$1"

  if [[ "$COLOR_MODE" = 'always' || "$COLOR_MODE" = 'auto' && -t "$stream" ]]; then
    c_reset=$'\e[0m'
    c_green=$'\e[32m'
    c_yellow=$'\e[33m'
    c_blue=$'\e[34m'
    c_grey=$'\e[90m'
    c_red=$'\e[31m'
    c_purple=$'\e[35m'
  else
    c_reset=''
    c_green=''
    c_yellow=''
    c_blue=''
    c_grey=''
    c_red=''
    c_purple=''
  fi
}

status_format=(
  changed '[+]' c_green
  complete '[✓]' c_green
  warn '[!]' c_yellow
  info '[·]' c_grey
  unchanged '[=]' c_blue
  failed '[x]' c_red
  input '[?]' c_purple
)

print_levels() {
  local i level
  local levels=()
  for (( i = 1; i <= ${#status_format}; i += 3 )); do
    level="${status_format[$i]}"
    levels+=("${(P)status_format[$i + 2]}$level$c_reset")
  done

  printf "%s\n" "$levels"
}

print_help() {
  local -a levels=($(print_levels))
  cat <<EOF
Usage: $PROGRAM_NAME [OPTION]... LEVEL MESSAGE...
       $PROGRAM_NAME [OPTION]... numbered NUMBER MESSAGE...
where LEVEL := { ${(j: | :)levels} }

Options:
  -c, --color=COLOR_MODE
        control when to use colored output; default is 'auto', which uses colors if stdout is a TTY
        where COLOR_MODE := { never | always | auto }
  -l, --list-levels
        display space-delimited list of available log levels and exit
  -h, --help
        display help message and exit
EOF
}

zparseopts -D -- \
  {h,-help}=FLAG_HELP \
  {l,-list-levels}=FLAG_LIST \
  {c,-color}:=ARG_COLOR

COLOR_MODE="${${ARG_COLOR[$#ARG_COLOR]:-auto}#=}"
case "$COLOR_MODE" in
  auto|never|always);;
  *) log-status failed "$PROGRAM_NAME: '$COLOR_MODE': invalid color mode"
     echo "Try '$PROGRAM_NAME --help' for more information." >&2
     exit 2
esac

if [[ -n "$FLAG_HELP" ]]; then
  set_colors 1
  print_help
  exit 0
fi

if [[ -n "$FLAG_LIST" ]]; then
  set_colors 1
  print_levels
  exit 0
fi

if [[ "$1" == numbered ]]; then
  if [[ $# -lt 3 ]]; then
    set_colors 2
    print_help >&2
    exit 2
  fi

  number="$2"
  shift 2
  message="$*"

  set_colors 1
  printf '%b[%s]%b %s\n' "$c_blue" "$number" "$c_reset" "$message"
  exit 0
fi

if [[ $# -lt 2 || "$1" == -h || "$1" == --help ]]; then
  set_colors 2
  print_help >&2
  exit 2
fi

level="$1"
shift
message="$*"

if [[ "$level" == input ]]; then
  output_stream=2
  newline=''
else
  if [[ "$level" == warn || "$level" == failed ]]; then
    output_stream=2
  else
    output_stream=1
  fi
  newline='\n'
fi

set_colors "$output_stream"

prefix='[?]'
color="$c_yellow"

for (( i = 1; i <= ${#status_format}; i += 3 )); do
  if [[ "$level" == "${status_format[$i]}" ]]; then
    prefix="${status_format[$i + 1]}"
    color="${(P)status_format[$i + 2]}"
    break
  fi
done

printf '%b%s%b %s%b' "$color" "$prefix" "$c_reset" "$message" "$newline" >&$output_stream

if [[ "$level" == input ]]; then
  read -r REPLY
  printf '%s\n' "$REPLY"
fi
