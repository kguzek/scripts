#!/usr/bin/env zsh

set -e

PROGRAM_NAME="${0:t}"
MAX_CONCURRENT_CHECKS=16
TEMPORARY_DIR_ROOT=/tmp/update-containers-script

print_help() {
  cat <<EOF
Usage: $PROGRAM_NAME [OPTION]...

Options:
  --dry-run, -n
        check for updates without pulling containers
  --no-sudo, -S
        skip checking elevated containers (for non-interactive use)
  --help, -h
        display help message and exit
EOF
}

zparseopts -D -- \
  {n,-dry-run}=FLAG_DRY_RUN \
  {S,-no-sudo}=FLAG_NO_SUDO \
  {h,-help}=FLAG_HELP

if [[ -n "$FLAG_HELP" ]]; then
  print_help
  exit 0
fi

for required_command in log-status time-script; do
  if command -v "$required_command" >/dev/null 2>&1; then
    continue
  fi

  echo "[x] Missing required command: $required_command" >&2
  exit 1
done

if (( $# > 0 )); then
  log-status failed "$PROGRAM_NAME: '$1': invalid argument"
  print_help >&2
  exit 2
fi

is_dry_run() {
  [[ -n "$FLAG_DRY_RUN" ]]
}

if (( EUID == 0 )); then
  IS_ROOT=true
else
  IS_ROOT=false
fi

if [[ -n "$FLAG_NO_SUDO" ]] || $IS_ROOT; then
  NO_SUDO=true
else
  NO_SUDO=false
fi

if ! $IS_ROOT && ! $NO_SUDO; then
  sudo -v 2>/dev/null || true
fi

time-script --start

detect_runtime() {
  local dir="$1"

  (
    cd "$dir" || exit 1

    local result

    result=$(docker compose ps --quiet 2>/dev/null) || true
    if [[ -n "$result" ]]; then
      echo "docker"
      exit 0
    fi

    result=$(podman compose ps --quiet 2>/dev/null) || true
    if [[ -n "$result" ]]; then
      echo "podman"
      exit 0
    fi

    if [[ "$NO_SUDO" == false ]]; then
      result=$(sudo podman compose ps --quiet 2>/dev/null) || true
      if [[ -n "$result" ]]; then
        echo "sudo podman"
        exit 0
      fi
    fi
  ) || true
}

run_compose() {
  local runtime="$1"; shift
  case "$runtime" in
    docker)        docker compose "$@" ;;
    podman)        podman compose "$@" ;;
    "sudo podman") sudo podman compose "$@" ;;
  esac
}

run_inspect() {
  local runtime="$1"; shift
  case "$runtime" in
    docker)        docker image inspect "$@" ;;
    podman)        podman image inspect "$@" ;;
    "sudo podman") sudo podman image inspect "$@" ;;
  esac
}

get_compose_images() {
  local runtime="$1"
  case "$runtime" in
    docker)
      docker compose config --images 2>/dev/null
      ;;
    *)
      run_compose "$runtime" config 2>/dev/null | yq '.services .[] | select(.image != null) .image'
      ;;
  esac
}

remote_digest() {
  local image="$1"
  local digest

  if command -v skopeo >/dev/null 2>&1; then
    digest=$(skopeo inspect "docker://$image" 2>/dev/null | jq -r '.Digest')
    if [[ -n "$digest" && "$digest" != "null" ]]; then
      echo "$digest"
      return 0
    fi
  fi

  digest=$(docker buildx imagetools inspect "$image" --format '{{.Manifest.Digest}}' 2>/dev/null) || true
  echo "$digest"
}

local_digests() {
  local image="$1"
  local runtime="$2"

  run_inspect "$runtime" --format '{{range .RepoDigests}}{{println .}}{{end}}' "$image" 2>/dev/null \
    | cut -d@ -f2
}

image_is_pinned() {
  [[ "$1" == *@sha256:* ]]
}

image_exists_locally() {
  local image="$1"
  local runtime="$2"

  run_inspect "$runtime" "$image" >/dev/null 2>&1
}

compose_needs_pull() {
  local runtime="$1"
  local image remote
  local needs_pull=false
  local -a images

  images=(${(f)"$(get_compose_images "$runtime")"})

  for image in "${images[@]}"; do
    if image_is_pinned "$image"; then
      if ! image_exists_locally "$image" "$runtime"; then
        log-status changed "Missing local image: $image"
        needs_pull=true
      fi

      continue
    fi

    remote=$(remote_digest "$image")

    if [[ -z "$remote" ]]; then
      log-status warn "Could not check remote digest for $image (skipping)"
      continue
    fi

    if ! local_digests "$image" "$runtime" | grep -qx "$remote"; then
      log-status changed "Update available: $image"
      needs_pull=true
    fi
  done

  [ "$needs_pull" = true ]
}

check_compose_project() {
  local compose_file="$1"
  local result_file="$2"
  local container_dir project_name runtime

  container_dir=$(dirname "$compose_file")

  (
    cd "$container_dir"

    log-status info "Checking $container_dir"
    project_name="$(basename "$container_dir")"

    runtime=$(detect_runtime "$container_dir")

    if [[ -z "$runtime" ]]; then
      log-status warn "$project_name: no running containers found (skipping)"
      exit 0
    fi

    if compose_needs_pull "$runtime"; then
      print -r -- "$container_dir" > "$result_file"
    else
      log-status unchanged "$project_name is up to date"
    fi
  )
}

wait_for_checks() {
  local pid

  for pid in "${check_pids[@]}"; do
    if ! wait "$pid"; then
      check_failures=$((check_failures + 1))
    fi
  done

  check_pids=()
}

mkdir -p "$TEMPORARY_DIR_ROOT"
TEMP_DIR=$(mktemp -d "$TEMPORARY_DIR_ROOT/run.XXXXXXXXXX")
trap 'rm -rf "$TEMP_DIR"' EXIT

compose_files=(/data/apps/*/compose.yaml(N) /opt/*/compose.yaml(N))
check_failures=0
check_index=0
check_pids=()
update_failures=0
update_errors=()

for compose_file in "${compose_files[@]}"; do
  check_index=$((check_index + 1))
  check_compose_project "$compose_file" "$TEMP_DIR/$check_index" &
  check_pids+=("$!")

  if (( ${#check_pids} >= MAX_CONCURRENT_CHECKS )); then
    wait_for_checks
  fi
done

wait_for_checks

if (( check_failures > 0 )); then
  if (( check_failures == 1 )); then
    s=""
  else
    s="s"
  fi
  log-status failed "Failed to check $check_failures container$s"
  exit 1
fi

record_update_failure() {
  local project="$1" step="$2"
  log-status warn "$project: $step failed"
  update_errors+=("$project: $step failed")
  update_failures=$((update_failures + 1))
}

for result_file in "$TEMP_DIR"/*(Nn); do
  container_dir=$(<"$result_file")
  project_name="$(basename "$container_dir")"
  runtime=$(detect_runtime "$container_dir")

  if [[ -z "$runtime" ]]; then
    log-status warn "$project_name: no running containers found (skipping)"
    continue
  fi

  cd "$container_dir"

  if is_dry_run; then
    log-status changed "Would update $project_name"
  else
    log-status changed "Updating $project_name"
    if ! run_compose "$runtime" pull; then
      record_update_failure "$project_name" "pull"
      continue
    fi
    if ! run_compose "$runtime" down; then
      record_update_failure "$project_name" "down"
      continue
    fi
    if ! run_compose "$runtime" up -d; then
      record_update_failure "$project_name" "up"
    fi
  fi
done

if is_dry_run; then
  updated_verb="checked for updates"
else
  updated_verb="updated"
fi

if (( update_failures > 0 )); then
  if (( update_failures == 1 )); then
    s=""
  else
    s="s"
  fi
  log-status failed "Failed to update $update_failures container$s:"
  for err in "${update_errors[@]}"; do
    log-status failed "  - $err"
  done
  exit 1
fi

log-status complete "All containers $updated_verb in $(time-script --end)s"
