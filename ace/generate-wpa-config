#!/usr/bin/env zsh

PROGRAM_NAME="${0:t}"
DEFAULT_INTERFACE_NAME='wlan0'

print_help() {
  cat <<EOF
Usage: $PROGRAM_NAME [OPTION]... NETWORK_NAME [INTERFACE_NAME]

Options:
  -i, --list-interfaces
        display available network interface names and exit
  -n, --list-networks
        display available network names and exit
  -h, --help
        display help message and exit
EOF
}

zparseopts -D -- \
  {i,-list-interfaces}=FLAG_INTERFACES \
  {n,-list-networks}=FLAG_NETWORKS \
  {h,-help}=FLAG_HELP

if [[ -n "$FLAG_HELP" ]]; then
  print_help
  exit 0
fi

if [[ -n "$FLAG_NETWORKS" ]]; then
  nmcli connection show
  exit 0
fi

if [[ -n "$FLAG_INTERFACES" ]]; then
  ip -oneline addr show
  exit 0
fi

NETWORK_NAME="$1"
INTERFACE_NAME="${2:-"$DEFAULT_INTERFACE_NAME"}"

if [[ -z "$NETWORK_NAME" || -z "$INTERFACE_NAME" ]]; then
  print_help >&2
  exit 2
fi

if ! nmcli connection show "$NETWORK_NAME" >/dev/null 2>&1; then
  log-status failed "$PROGRAM_NAME: '$NETWORK_NAME': invalid network name"
  log-status info "Try 'nmcli connection show' or '$PROGRAM_NAME --help' for more information." >&2
  exit 2
fi

CONFIG_FILENAME="/etc/wpa_supplicant/wpa_supplicant-$INTERFACE_NAME.conf"

if ! touch "$CONFIG_FILENAME"; then
  log-status failed 'This script needs to be run as someone who has permission to edit system network files. Try again with:'
  echo "sudo $PROGRAM_NAME" >&2
  exit 1
fi

if ! NETWORK_SSID="$(nmcli --escape no --get-values 802-11-wireless.ssid connection show "$NETWORK_NAME")" || [[ -z "$NETWORK_SSID" ]]; then
  log-status failed "$PROGRAM_NAME: failed to read SSID for '$NETWORK_NAME'"
  exit 1
fi

if ! NETWORK_PSK="$(nmcli --escape no --show-secrets --get-values 802-11-wireless-security.psk connection show "$NETWORK_NAME")" || [[ -z "$NETWORK_PSK" ]]; then
  if ! NETWORK_PSK="$(log-status --private input "Wi-Fi passphrase for $NETWORK_SSID: ")"; then
    log-status failed "$PROGRAM_NAME: failed to read passphrase"
    exit 1
  fi
fi

if ! NETWORK_CONFIG="$(print -r -- "$NETWORK_PSK" | wpa_passphrase "$NETWORK_SSID" 2> >(sed '/^# reading passphrase from stdin$/d' >&2))"; then
  log-status failed "$PROGRAM_NAME: failed to generate WPA configuration for '$NETWORK_NAME'"
  exit 1
fi

if ! print -r -- "$NETWORK_CONFIG" >> "$CONFIG_FILENAME"; then
  log-status failed "$PROGRAM_NAME: failed to write configuration to $CONFIG_FILENAME"
  exit 1
fi
log-status complete "Configuration written to $CONFIG_FILENAME"
