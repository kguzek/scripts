#!/usr/bin/env zsh

set -e

PROGRAM_NAME="${0:t}"
source "${0:A:h}/.lxc-defaults"

print_help() {
  cat <<EOF
Usage: $PROGRAM_NAME [OPTION]... CONTAINER
where CONTAINER := { NAME | ID }
Create the Docker context NAME in doco-cd ($DOCO_CD_ID), pinning the container's SSH host key.

Options:
  -r, --remove
        remove the context and its host key
  -d, --dry-run
        print commands instead of running them
  -h, --help
        display help message and exit
EOF
}

doco() {
  run pct exec "$DOCO_CD_ID" -- "$@"
}

has_context() {
  pct exec "$DOCO_CD_ID" -- docker context inspect "$1" >/dev/null 2>&1
}

zparseopts -D -E -- \
  {r,-remove}=FLAG_REMOVE \
  {d,-dry-run}=FLAG_DRY_RUN \
  {h,-help}=FLAG_HELP

if [[ -n "$FLAG_HELP" ]]; then
  print_help
  exit 0
fi

if (( $# != 1 )); then
  log-status failed "$PROGRAM_NAME: expected exactly one container"
  echo "Try '$PROGRAM_NAME --help' for more information." >&2
  exit 2
fi

DRY_RUN="${FLAG_DRY_RUN:+1}"

if ! pct status "$DOCO_CD_ID" 2>/dev/null | grep -q running; then
  log-status failed "$PROGRAM_NAME: doco-cd ($DOCO_CD_ID) is not running"
  exit 1
fi

ID="$(resolve_lxc "$1")"
if [[ -n "$ID" ]]; then
  NAME="$(lxc_name_of "$ID")"
  IP="$(lxc_ip_of "$ID")"
elif [[ -n "$FLAG_REMOVE" && "$1" != <-> ]]; then
  NAME="$1"
else
  log-status failed "$PROGRAM_NAME: '$1': no such container"
  exit 1
fi

if [[ -n "$FLAG_REMOVE" ]]; then
  if ! has_context "$NAME"; then
    log-status unchanged "No Docker context named $NAME"
    exit 0
  fi
  if [[ -z "$IP" ]]; then
    IP="$(pct exec "$DOCO_CD_ID" -- docker context inspect "$NAME" --format '{{.Endpoints.docker.Host}}')"
    IP="${IP#ssh://*@}"
  fi
  doco docker context rm --force "$NAME" >/dev/null
  doco sh -c "ssh-keygen -R '$IP' >/dev/null 2>&1 || true"
  log-status complete "Removed Docker context $NAME"
  exit 0
fi

if [[ -z "$IP" ]]; then
  log-status failed "$PROGRAM_NAME: $NAME has no static IP"
  exit 1
fi
if ! pct exec "$DOCO_CD_ID" -- test -f /root/.ssh/id_ed25519; then
  log-status failed "$PROGRAM_NAME: doco-cd has no /root/.ssh/id_ed25519"
  exit 1
fi

HOST_KEY="$(pct exec "$ID" -- cat /etc/ssh/ssh_host_ed25519_key.pub | awk '{ print $1, $2 }')"
if [[ -z "$HOST_KEY" ]]; then
  log-status failed "$PROGRAM_NAME: could not read the SSH host key of $NAME"
  exit 1
fi

doco sh -c "ssh-keygen -R '$IP' >/dev/null 2>&1 || true"
doco sh -c "echo '$IP $HOST_KEY' >> /root/.ssh/known_hosts"

if has_context "$NAME"; then
  doco docker context update "$NAME" --docker "host=ssh://root@$IP" >/dev/null
else
  doco docker context create "$NAME" --docker "host=ssh://root@$IP" >/dev/null
fi

if [[ -z "$DRY_RUN" ]]; then
  VERSION="$(pct exec "$DOCO_CD_ID" -- docker --context "$NAME" version --format '{{.Server.Version}}')"
  log-status complete "Docker context $NAME -> ssh://root@$IP (Docker $VERSION)"
fi
