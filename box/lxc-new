#!/usr/bin/env zsh

set -e

PROGRAM_NAME="${0:t}"
source "${0:A:h}/.lxc-defaults"

print_help() {
  cat <<EOF
Usage: $PROGRAM_NAME [OPTION]... NAME ID
Clone template $TEMPLATE_ID into container ID with the address $SUBNET_PREFIX.ID.

Options:
  -m, --memory=MB
        memory limit; default 1024
  -c, --cores=N
        CPU cores; default 2
  -s, --disk=GB
        grow the root disk to this size
  -v, --volume=POOL:PATH[:GB][:nobackup]
        add a data volume (see lxc-volume); can be repeated
  -N, --no-context
        skip creating the doco-cd Docker context
  -n, --no-start
        do not start the container; implies --no-context
  -d, --dry-run
        print commands instead of running them
  -h, --help
        display help message and exit
EOF
}

wait_for_ssh() {
  local tries=60
  while (( tries-- )); do
    timeout 1 bash -c "</dev/tcp/$1/22" 2>/dev/null && return 0
    sleep 1
  done
  return 1
}

zparseopts -D -E -- \
  {m,-memory}:=ARG_MEMORY \
  {c,-cores}:=ARG_CORES \
  {s,-disk}:=ARG_DISK \
  {v,-volume}+:=ARG_VOLUMES \
  {N,-no-context}=FLAG_NO_CONTEXT \
  {n,-no-start}=FLAG_NO_START \
  {d,-dry-run}=FLAG_DRY_RUN \
  {h,-help}=FLAG_HELP

if [[ -n "$FLAG_HELP" ]]; then
  print_help
  exit 0
fi

if (( $# != 2 )); then
  log-status failed "$PROGRAM_NAME: expected NAME and ID"
  echo "Try '$PROGRAM_NAME --help' for more information." >&2
  exit 2
fi

NAME="$1"
ID="$2"
IP="$SUBNET_PREFIX.$ID"
MEMORY="${${ARG_MEMORY[-1]:-1024}#=}"
CORES="${${ARG_CORES[-1]:-2}#=}"
DISK="${${ARG_DISK[-1]}#=}"
DRY_RUN="${FLAG_DRY_RUN:+1}"
VOLUMES=()
for (( i = 2; i <= $#ARG_VOLUMES; i += 2 )); do
  VOLUMES+=("${ARG_VOLUMES[$i]#=}")
done

if [[ ! "$NAME" =~ '^[a-z][a-z0-9-]{0,62}$' ]]; then
  log-status failed "$PROGRAM_NAME: '$NAME': invalid name"
  exit 2
fi
if [[ "$ID" != <-> ]] || (( ID < 100 || ID > 254 )); then
  log-status failed "$PROGRAM_NAME: '$ID': ID must be between 100 and 254"
  exit 2
fi
for value in "$MEMORY" "$CORES" ${DISK:+"$DISK"}; do
  if [[ "$value" != <-> ]]; then
    log-status failed "$PROGRAM_NAME: '$value': expected a number"
    exit 2
  fi
done
for volume in $VOLUMES; do
  if [[ "$volume" != *:/* ]]; then
    log-status failed "$PROGRAM_NAME: '$volume': expected POOL:PATH"
    exit 2
  fi
done

if pct config "$ID" >/dev/null 2>&1; then
  log-status failed "$PROGRAM_NAME: container $ID already exists"
  exit 1
fi
if [[ -n "$(lxc_id_of "$NAME")" ]]; then
  log-status failed "$PROGRAM_NAME: container '$NAME' already exists"
  exit 1
fi
if ! pct config "$TEMPLATE_ID" 2>/dev/null | grep -q '^template: 1'; then
  log-status failed "$PROGRAM_NAME: template $TEMPLATE_ID not found"
  exit 1
fi
if [[ ! -d "$SERVICES_SOURCE/.git" ]]; then
  log-status failed "$PROGRAM_NAME: $SERVICES_SOURCE is not a git clone; see services-sync"
  exit 1
fi
if ping -c 1 -W 1 "$IP" >/dev/null 2>&1; then
  log-status failed "$PROGRAM_NAME: $IP is already in use"
  exit 1
fi

log-status info "Cloning template $TEMPLATE_ID into $NAME ($ID)"
run pct clone "$TEMPLATE_ID" "$ID" --hostname "$NAME" --full
run pct set "$ID" \
  --net0 "name=eth0,bridge=$BRIDGE,ip=$IP/$SUBNET_MASK,gw=$GATEWAY,firewall=1" \
  --mp0 "$TOOLS_SOURCE,mp=$TOOLS_TARGET,ro=1" \
  --mp1 "$SERVICES_SOURCE,mp=$SERVICES_TARGET,ro=1" \
  --cores "$CORES" \
  --memory "$MEMORY" \
  --onboot 1

if [[ -n "$DISK" ]]; then
  run pct resize "$ID" rootfs "${DISK}G"
fi

for volume in $VOLUMES; do
  run "${0:A:h}/lxc-volume" "$ID" "$volume"
done

if [[ -n "$FLAG_NO_START" ]]; then
  log-status complete "Created $NAME ($ID)"
  exit 0
fi

log-status info "Starting $NAME"
run pct start "$ID"

if [[ -z "$DRY_RUN" ]] && ! wait_for_ssh "$IP"; then
  log-status failed "$PROGRAM_NAME: no SSH on $IP after 60 seconds"
  exit 1
fi

if [[ -z "$FLAG_NO_CONTEXT" ]]; then
  run "${0:A:h}/lxc-context" "$ID"
fi

log-status complete "Created $NAME ($ID) at $IP"
