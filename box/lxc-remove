#!/usr/bin/env zsh

set -e

PROGRAM_NAME="${0:t}"
source "${0:A:h}/.lxc-defaults"

print_help() {
  cat <<EOF
Usage: $PROGRAM_NAME [OPTION]... CONTAINER
where CONTAINER := { NAME | ID }
Back up a container to $BACKUP_STORAGE, then destroy it and its volumes.

Options:
  -B, --no-backup
        skip the backup
  -y, --yes
        do not ask for confirmation
  -d, --dry-run
        print commands instead of running them
  -h, --help
        display help message and exit
EOF
}

zparseopts -D -E -- \
  {B,-no-backup}=FLAG_NO_BACKUP \
  {y,-yes}=FLAG_YES \
  {d,-dry-run}=FLAG_DRY_RUN \
  {h,-help}=FLAG_HELP

if [[ -n "$FLAG_HELP" ]]; then
  print_help
  exit 0
fi

if (( $# != 1 )); then
  log-status failed "$PROGRAM_NAME: expected exactly one container"
  echo "Try '$PROGRAM_NAME --help' for more information." >&2
  exit 2
fi

DRY_RUN="${FLAG_DRY_RUN:+1}"

ID="$(resolve_lxc "$1")"
if [[ -z "$ID" ]]; then
  log-status failed "$PROGRAM_NAME: '$1': no such container"
  exit 1
fi
NAME="$(lxc_name_of "$ID")"

if [[ "$ID" == "$TEMPLATE_ID" || "$ID" == "$DOCO_CD_ID" ]]; then
  log-status failed "$PROGRAM_NAME: refusing to remove $NAME ($ID)"
  exit 1
fi
if [[ -z "$FLAG_NO_BACKUP" ]] && ! pvesm status --storage "$BACKUP_STORAGE" >/dev/null 2>&1; then
  log-status failed "$PROGRAM_NAME: $BACKUP_STORAGE is not available"
  exit 1
fi

log-status info "Volumes of $NAME ($ID):"
pct config "$ID" | grep -E '^(rootfs|mp[0-9]+): [^/]' | sed 's/^/    /'

if [[ -z "$FLAG_YES" && -z "$DRY_RUN" ]]; then
  REPLY="$(log-status input "Type '$NAME' to destroy it: ")"
  if [[ "$REPLY" != "$NAME" ]]; then
    log-status failed "Aborted"
    exit 1
  fi
fi

if [[ -z "$FLAG_NO_BACKUP" ]]; then
  log-status info "Backing up $NAME"
  run vzdump "$ID" --storage "$BACKUP_STORAGE" --mode snapshot --notes-template "{{guestname}} before removal"
fi

if pct status "$DOCO_CD_ID" 2>/dev/null | grep -q running; then
  "${0:A:h}/lxc-context" ${DRY_RUN:+--dry-run} --remove "$NAME"
else
  log-status warn "doco-cd is not running; run 'lxc-context --remove $NAME' later"
fi

if pct status "$ID" | grep -q running; then
  run pct stop "$ID"
fi
run pct destroy "$ID" --purge

log-status complete "Removed $NAME ($ID)"
