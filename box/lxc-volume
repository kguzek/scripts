#!/usr/bin/env zsh

set -e

PROGRAM_NAME="${0:t}"
source "${0:A:h}/.lxc-defaults"

print_help() {
  cat <<EOF
Usage: $PROGRAM_NAME [OPTION]... CONTAINER POOL:PATH[:GB][:nobackup]
where CONTAINER := { NAME | ID }
      POOL := { ${(j: | :)${(ok)VOLUME_STORAGES}} }
Add a volume of GB gigabytes (default $DEFAULT_VOLUME_GB) mounted at PATH.

Options:
  -d, --dry-run
        print commands instead of running them
  -h, --help
        display help message and exit
EOF
}

zparseopts -D -E -- \
  {d,-dry-run}=FLAG_DRY_RUN \
  {h,-help}=FLAG_HELP

if [[ -n "$FLAG_HELP" ]]; then
  print_help
  exit 0
fi

if (( $# != 2 )) || [[ "$2" != *:/* ]]; then
  log-status failed "$PROGRAM_NAME: expected CONTAINER and POOL:PATH"
  echo "Try '$PROGRAM_NAME --help' for more information." >&2
  exit 2
fi

DRY_RUN="${FLAG_DRY_RUN:+1}"
SPEC=("${(@s/:/)2}")
POOL="${SPEC[1]}"
TARGET="${SPEC[2]%/}"
SIZE="$DEFAULT_VOLUME_GB"
BACKUP=1
for field in "${(@)SPEC[3,-1]}"; do
  case "$field" in
    <->) SIZE="$field" ;;
    nobackup) BACKUP=0 ;;
    *)
      log-status failed "$PROGRAM_NAME: '$field': expected GB or 'nobackup'"
      exit 2
      ;;
  esac
done

STORAGE="${VOLUME_STORAGES[$POOL]}"
if [[ -z "$STORAGE" ]]; then
  log-status failed "$PROGRAM_NAME: '$POOL': unknown pool"
  exit 2
fi

ID="$(resolve_lxc "$1")"
if [[ -z "$ID" ]]; then
  log-status failed "$PROGRAM_NAME: '$1': no such container"
  exit 1
fi
NAME="$(lxc_name_of "$ID")"

CONFIG="$(pct config "$ID")"
if grep -q "^mp[0-9]*: .*mp=$TARGET\(,\|$\)" <<<"$CONFIG"; then
  log-status unchanged "$TARGET is already mounted in $NAME"
  exit 0
fi

MP_INDEX=2
while grep -q "^mp$MP_INDEX:" <<<"$CONFIG"; do
  (( MP_INDEX++ ))
done

log-status info "Adding ${SIZE}G volume on $STORAGE at $TARGET in $NAME${${BACKUP:#1}:+ (not backed up)}"
run pct set "$ID" "--mp$MP_INDEX" "$STORAGE:$SIZE,mp=$TARGET,backup=$BACKUP"

if [[ -z "$DRY_RUN" ]] && pct pending "$ID" | grep -q "^new mp$MP_INDEX:"; then
  log-status warn "Restart $NAME to apply the change (pct reboot $ID)"
fi
