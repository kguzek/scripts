TEMPLATE_ID=9000
DOCO_CD_ID=110

BRIDGE=vmbr0
SUBNET_PREFIX=192.168.0
SUBNET_MASK=24
GATEWAY=192.168.0.1

VPN_SUBNET=10.1.7.0/24
VPN_GATEWAY=192.168.0.227

TOOLS_SOURCE=/rpool/tools
TOOLS_TARGET=/opt/tools

SERVICES_SOURCE=/rpool/services
SERVICES_TARGET=/srv/services

declare -A VOLUME_STORAGES=(
  dpool dpool
  rpool local-zfs
)
DEFAULT_VOLUME_GB=10
BACKUP_STORAGE=pbs-box

run() {
  if [[ -n "$DRY_RUN" ]]; then
    print -r -- "+ ${(j: :)${(q-)@}}" >&2
  else
    "$@"
  fi
}

lxc_id_of() {
  pct list | awk -v name="$1" 'NR > 1 && $NF == name { print $1 }'
}

lxc_name_of() {
  pct config "$1" 2>/dev/null | sed -n 's/^hostname: //p'
}

lxc_ip_of() {
  pct config "$1" 2>/dev/null | sed -n 's|^net0:.*[:,]ip=\([0-9.]*\)/.*|\1|p'
}

resolve_lxc() {
  if [[ "$1" != <-> ]]; then
    lxc_id_of "$1"
  elif pct config "$1" >/dev/null 2>&1; then
    print -r -- "$1"
  fi
  return 0
}
